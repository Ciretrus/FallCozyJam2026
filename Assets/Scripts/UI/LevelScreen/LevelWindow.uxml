<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="HelpPopup" src="project://database/Assets/Prefabs/UI/HelpPopup.uxml?fileID=9197481963319205126&amp;guid=5319f14d7cd78654dac675ca32db2478&amp;type=3#HelpPopup" />
    <Style src="project://database/Assets/Scripts/UI/LevelScreen/LevelWindow.uss?fileID=7433441132597879392&amp;guid=5c48a993663491340a68c19e52a885fc&amp;type=3#LevelWindow" />
    <ui:VisualElement name="Body" style="flex-grow: 1;">
        <ui:VisualElement name="Upper" style="flex-grow: 1; align-content: flex-end; flex-direction: row;">
            <ui:VisualElement name="Exit" style="flex-grow: 1; flex-direction: row; margin-top: 60px; margin-left: 60px;">
                <ui:Button name="Help" class="exit-button" style="align-content: center; flex-direction: row; margin-top: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-right: 0; margin-bottom: 0;">
                    <ui:VisualElement name="exit-image" class="exit-image" style="flex-grow: 1; background-image: resource(&apos;UI/exit-vector&apos;); flex-direction: row-reverse; justify-content: flex-end; align-items: auto; align-self: center;" />
                </ui:Button>
                <ui:VisualElement name="Score" style="flex-grow: 1; padding-left: 0; width: 281px; min-width: 281px; max-width: 281px; height: 80px; left: auto; top: auto; margin-left: 55px; align-content: flex-start; background-color: rgb(144, 93, 65); border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-right-radius: 24px; border-bottom-left-radius: 24px; flex-direction: row; align-self: flex-start;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; align-self: center; justify-content: center;">
                        <ui:Label text="money:&#10;" name="Text" style="align-self: center; flex-direction: column-reverse; align-content: center; justify-content: center; align-items: center; color: rgb(255, 241, 219); font-size: 44px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 15px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-left; white-space: pre; text-overflow: clip; position: absolute; top: -33px; left: 0; height: 61px; min-height: 61px; max-height: 61px;" />
                        <ui:Label text="300&#10;" name="ScoreText" emoji-fallback-support="false" style="color: rgb(255, 241, 219); align-self: center; font-size: 44px; margin-top: 0; margin-right: 15px; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-right; text-overflow: ellipsis; position: absolute; right: 0; bottom: auto; height: 61px; min-height: 61px; max-height: 61px; top: -33px; flex-direction: column-reverse; justify-content: center; align-content: center; align-items: center;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Task" style="flex-grow: 1; margin-top: 80px; margin-right: 60px;">
                <ui:VisualElement name="TaskBoard" style="flex-grow: 1; max-width: none; max-height: none; flex-direction: row; align-items: flex-start; justify-content: center; align-self: flex-end; min-width: 200px; min-height: 200px; align-content: flex-end; margin-top: 0; margin-right: 0; left: 0%; top: 0%; right: 0%; bottom: 0%; position: absolute; border-left-color: rgb(144, 93, 65); border-right-color: rgb(144, 93, 65); border-top-color: rgb(144, 93, 65); border-bottom-color: rgb(144, 93, 65);">
                    <ui:VisualElement name="TaskContent" style="flex-grow: 1; width: 369px; left: auto; position: absolute; right: 0; bottom: 0%; top: 0%; color: rgb(255, 241, 219); max-width: 521px; max-height: 287px; margin-top: 20px; flex-direction: column; align-items: flex-end; justify-content: flex-end; align-self: center; align-content: flex-end; min-width: 300px; min-height: 100px; background-color: rgb(255, 241, 219); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
                        <ui:ScrollView mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" name="ScrollView" focusable="false" nested-interaction-kind="ForwardScrolling" language-direction="LTR" touch-scroll-type="Clamped" usage-hints="None" style="position: absolute; left: 0%; top: 0%; right: 1%; bottom: 8%; margin-top: 70px; align-items: flex-start; justify-content: flex-start;">
                            <ui:VisualElement name="TasksTexts" style="flex-grow: 1;" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:Label text="TASK" name="TaskName" emoji-fallback-support="true" style="position: absolute; top: 0%; right: 0%; left: auto; background-color: rgb(144, 93, 65); color: rgb(255, 241, 219); padding-top: 6px; padding-right: 24px; padding-bottom: 12px; padding-left: 24px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-right-radius: 24px; border-bottom-left-radius: 24px; width: auto; height: auto; font-size: 44px; -unity-text-align: middle-center; max-height: none; max-width: none; min-height: auto; min-width: auto;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Down" style="flex-grow: 1; align-items: stretch; justify-content: flex-start; align-self: stretch; flex-direction: row; margin-bottom: 80px; margin-left: 60px; margin-right: 60px;">
            <ui:VisualElement name="Shop" style="flex-grow: 1; flex-direction: column-reverse;">
                <ui:VisualElement name="ShopBg" style="flex-grow: 0; max-width: 550px; max-height: 260px; background-color: rgb(255, 241, 219); border-left-color: rgb(144, 93, 65); border-right-color: rgb(144, 93, 65); border-top-color: rgb(144, 93, 65); border-bottom-color: rgb(144, 93, 65); border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px; flex-direction: row; margin-left: 0; margin-right: 0; margin-top: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; min-height: 260px; height: 260px; min-width: 550px; flex-wrap: nowrap; justify-content: center; align-self: flex-start; align-content: center;">
                    <ui:ScrollView mode="Horizontal" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="AlwaysVisible" name="ScrollView" focusable="false" nested-interaction-kind="Default" language-direction="LTR" touch-scroll-type="Clamped" usage-hints="None" style="position: absolute; left: 0%; top: 0%; right: 0; bottom: 0; margin-top: 0; align-items: flex-start; margin-right: 50px; margin-bottom: 0; margin-left: 50px; align-self: flex-start; justify-content: flex-start; flex-direction: column; padding-left: 0; flex-basis: auto; padding-right: 0; padding-top: 0; padding-bottom: 0; flex-grow: 1; overflow: visible; visibility: visible; display: flex; flex-shrink: 0;">
                        <ui:VisualElement name="ShopContent" enabled="true" class="shop-rows" style="flex-grow: 0; top: auto; bottom: auto; left: auto; max-width: none; min-width: auto; max-height: none; min-height: auto; align-items: flex-start; justify-content: flex-end; flex-direction: row; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; align-content: auto; align-self: flex-end; flex-basis: auto; flex-shrink: 0; -unity-slice-type: sliced; flex-wrap: nowrap; overflow: hidden; opacity: 1;" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Help" style="flex-grow: 1; width: 351px; padding-bottom: 0; padding-right: 0; flex-direction: column-reverse;">
                <ui:Button text="HELP ?" name="HelpButton" style="color: rgb(255, 241, 219); background-color: rgba(255, 241, 219, 0.43); position: absolute; right: 0%; bottom: 0%; margin-bottom: 0; align-self: flex-end; justify-content: space-around; align-content: flex-start; flex-direction: column-reverse; font-size: 46px; border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-right-radius: 24px; border-bottom-left-radius: 24px; min-width: auto; padding-right: 24px; padding-left: 24px; padding-top: 6px; padding-bottom: 12px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="HelpPopup" name="HelpPopup" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: none;" />
    </ui:VisualElement>
</ui:UXML>
