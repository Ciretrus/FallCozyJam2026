<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/StartScreen/StartWindow.uss?fileID=7433441132597879392&amp;guid=a49c60e79d76c9c4597540fbe2d87a69&amp;type=3#StartWindow" />
    <ui:VisualElement name="Body" style="flex-grow: 1;">
        <ui:VisualElement name="Content" style="flex-grow: 1; top: 13.5%; bottom: 223px; position: absolute; left: 0%; right: 0%;">
            <ui:Label text="The Name of the Game" name="Title" style="color: rgb(102, 32, 32); -unity-text-align: upper-center; font-size: 128px; -unity-text-outline-width: 5px; -unity-text-outline-color: rgb(255, 194, 64); text-shadow: 0 0 0 rgb(255, 194, 64);" />
            <ui:VisualElement name="buttons" style="flex-grow: 1; justify-content: space-between; top: 242px; position: absolute; left: 40%; right: 40%; bottom: 0%;">
                <ui:Button text="Play" name="Play" class="start-button" style="padding-bottom: 40px; height: 160px; width: 376px;" />
                <ui:VisualElement name="sliders" style="flex-grow: 1;">
                    <ui:VisualElement name="SoundContent" style="flex-grow: 1; margin-top: 30px;">
                        <ui:Label text="Sound" name="SoundLabel" class="slider-label" style="-unity-text-align: upper-center;" />
                        <ui:SliderInt value="42" high-value="100" name="Sound" />
                    </ui:VisualElement>
                    <ui:VisualElement name="MusicContent" style="flex-grow: 1;">
                        <ui:Label text="Music" name="MusicLabel" class="slider-label" style="-unity-text-align: upper-center;" />
                        <ui:SliderInt value="42" high-value="100" name="Music" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
